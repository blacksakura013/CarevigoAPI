# Copy to .env.local for local development. Keep all real credentials private.
# Production reads environment variables configured in the hosting service.
NODE_ENV=development
PORT=8080
MONGO_URI=mongodb://127.0.0.1:27017/carevigo_db
JWT_SECRET=replace-with-a-long-random-signing-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Staff recovery and review notifications require a working Gmail sender.
EMAIL_USER=
EMAIL_PASS=

# Production requires an allowlisted HTTPS FRONTEND_URL and production origins.
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Optional integrations. Leave empty unless the integration is configured.
OPENAI_API_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
